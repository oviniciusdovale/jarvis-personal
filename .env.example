# Copie para .env e preencha. Nunca versione o .env.

# Token do bot, gerado no @BotFather do Telegram
TELEGRAM_BOT_TOKEN=

# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo usado para gerar e revisar rascunhos
ANTHROPIC_MODEL=claude-sonnet-5

# IDs do Telegram autorizados a usar o bot, separados por vírgula.
# Para descobrir o seu, mande qualquer mensagem ao bot: ele responde com o ID.
ALLOWED_TELEGRAM_IDS=

# Onde os dados do piloto ficam salvos (JSON)
DATA_DIR=./data
